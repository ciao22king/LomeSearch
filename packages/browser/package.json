{
  "name": "@lomesearch/browser",
  "version": "1.0.0",
  "private": true,
  "description": "LomeSearch desktop browser",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "start:engine": "node ../engine/dist/src/cli.js serve",
    "start:dev": "node build.mjs --dev && electron .",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "devDependencies": {
    "@lomesearch/engine": "1.0.0",
    "electron": "^33.2.1",
    "esbuild": "^0.24.2"
  }
}
