<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Usable as a browser: plain HTTP sites stay reachable, the local engine is
         usually http://127.0.0.1:7717 or http://<host>:7717. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
